# Verifier credentials. Copy to `.env` and fill in ONE of the keys below.
# Whichever backend you use must expose token-level logprobs — the
# fine-grained reward reads the score-token logprob distribution.

# DeepSeek's OpenAI-compatible API (https://api.deepseek.com,
# `deepseek-v4-flash`). The default backend.
DEEPSEEK_API_KEY=

# Gemini via Vertex AI (`gemini-2.5-flash`). Vertex AI only: the plain
# Gemini API does not expose token logprobs.
# VERTEX_API_KEY=

# Any other OpenAI-compatible server that returns logprobs, e.g. a local
# vLLM (`vllm serve Qwen/Qwen3.5-9B` -> http://localhost:8000/v1) or
# https://api.deepseek.com. OPENAI_API_KEY can stay empty for local servers.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
